# Jot works fully offline. To add the optional AI features, copy this file to
# ".env" (same folder), set a provider below, and restart Jot.
# .env is gitignored, so your key never lands in the repository.

# Which AI to use: tamu | openai | openrouter | ollama | custom
# Leave blank (or "none") for offline mode.
JOT_PROVIDER=

# Optional: override the provider's default model.
# Required for openrouter, ollama and custom.
#JOT_MODEL=

# Only for JOT_PROVIDER=custom (any OpenAI-compatible endpoint):
#JOT_BASE_URL=
#JOT_API_KEY=

# --- Keys (set the one that matches your provider) ---
# TAMU AI (free with a Texas A&M NetID): chat.tamu.ai -> Settings -> API Key.
# Also read from ~/.config/tamu-ai/api-key if that file exists.
#TAMU_AI_API_KEY=
#OPENAI_API_KEY=
#OPENROUTER_API_KEY=
# Ollama (a model on your own computer) needs no key: run `ollama serve`
# and set JOT_MODEL to a model you have pulled.

# Optional: where your ideas are stored (default: the jot_data folder here).
#JOT_DATA=
# Optional: port (default 5057).
#JOT_PORT=
